# Dr_Booking — Environment Variables (WhatsApp-only)
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── Required ─────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# WhatsApp Cloud API (Meta) — patient-facing bot
# Get these from: https://developers.facebook.com/apps/ → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
# A string you choose (e.g., "drb_verify_2026") — you'll enter it when setting up the webhook
WHATSAPP_VERIFY_TOKEN=drb_verify_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# ── Recommended ──────────────────────────────────────────────────────
# Public URL of this bot backend (Render URL)
PUBLIC_URL=https://your-app.onrender.com

# Port for the Express server (Render sets this automatically)
PORT=3000

# Dashboard URL (Vercel deployment of the dashboard/ directory)
DASHBOARD_URL=https://your-dashboard.vercel.app

# wa.me link to the WhatsApp Business number patients message to reach the bot
NEXT_PUBLIC_BOT_URL=https://wa.me/91XXXXXXXXXX

# Bot backend URL — the Express bot's origin, NOT the Next.js dashboard URL.
# The dashboard's notify helper POSTs to ${BOT_API_URL}/api/notify.
# If not set, it falls back to PUBLIC_URL → DASHBOARD_URL which will 404 on
# Next.js because /api/notify is only served by the Express backend.
BOT_API_URL=https://your-app.onrender.com

# Shared secret between bot and dashboard for magic link generation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_SECRET=your-shared-secret-here

# Platform flag (always "whatsapp" after migration)
PLATFORM=whatsapp
NEXT_PUBLIC_PLATFORM=whatsapp

# ── Dashboard-only (set these on Vercel) ─────────────────────────────
# MAGIC_LINK_BASE_URL=https://your-dashboard.vercel.app
# (defaults to DASHBOARD_URL if not set)

# Dev-only secret used by the dashboard's "Bot Access Required" page to simulate
# magic link generation in non-production environments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_DEV_BOT_SECRET=your-dev-bot-secret-here

# ── Super admin phone ────────────────────────────────────────────────
# Used by `npm run db:seed-superadmin` to promote a phone to SUPER_ADMIN.
# SUPER_ADMIN_PHONE=+910000000001

# ── Optional: Error monitoring webhook ───────────────────────────────
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Optional: Online payments ────────────────────────────────────────
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
