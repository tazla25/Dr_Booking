{
  "name": "smart-queue-bot",
  "version": "1.1.0",
  "description": "Smart Queue & Booking Bot — WhatsApp Micro-SaaS for local clinics",
  "main": "index.js",
  "scripts": {
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node prisma/seed.js",
    "db:seed-superadmin": "node prisma/seed-superadmin.js",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/database/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
