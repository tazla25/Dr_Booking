{
  "name": "smart-queue-bot",
  "version": "1.1.0",
  "description": "Smart Queue & Booking Bot — Telegram/WhatsApp Micro-SaaS for local clinics",
  "main": "index.js",
  "scripts": {
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node prisma/seed.js",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^6.11.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/database/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
