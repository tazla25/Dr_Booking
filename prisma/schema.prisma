// Dr_Booking — Reform Edition (Phase 1: Account Ownership Flip)
// Reformed schema addressing analysis issues:
//  - Race-condition safe queue numbers (UNIQUE on schedule+date+queue)
//  - Doctor-owned accounts with verification flow (replaces weak 4-digit PIN)
//  - Compounder is a delegated user scoped to a verified doctor
//  - Failed login attempts tracking (rate-limit / brute-force protection)
//  - Persistent bot sessions (replaces in-memory Map)
//  - Audit log for admin actions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────
// Account roles. Doctor owns the profile; compounder is delegated;
// super_admin is the platform founder (you).
enum Role {
  DOCTOR
  COMPOUNDER
  SUPER_ADMIN
}

// Verification lifecycle for doctor accounts.
// Compounders inherit access from their delegated doctor — they do not
// need individual verification, but they CAN be suspended independently.
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ── Doctor profile ───────────────────────────────────────────────────
// A Doctor profile is the patient-facing entity. It is OWNED by exactly
// one AdminUser (role=DOCTOR) and may have multiple compounders delegated
// to it.
model Doctor {
  id              String   @id @default(cuid())
  ownerAdminId    String   @unique // The AdminUser who owns this profile
  ownerAdmin      AdminUser @relation("DoctorOwner", fields: [ownerAdminId], references: [id], onDelete: Cascade)
  compounders     AdminUser[] @relation("DoctorCompounders")

  fullName        String
  specialization  String
  phone           String?
  email           String?
  fee             Int      @default(0)
  rating          Float    @default(0)
  isActive        Boolean  @default(true)
  timezone        String   @default("Asia/Kolkata")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Strategy v2: Trust & Rating System
  yearsExperience   Int      @default(0)
  isTopPick         Boolean  @default(false)
  specialties       String[] @default([])
  avgRating         Float    @default(0)
  reviewCount       Int      @default(0)
  appointmentCount  Int      @default(0)

  // Strategy v2: Live availability indicator
  isAvailableNow    Boolean  @default(false)

  schedules    Schedule[]
  appointments Appointment[] @relation("DoctorAppointments")

  @@map("doctors")
}

model Schedule {
  id                   String   @id @default(cuid())
  doctorId             String
  doctor               Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  pinCode              Int
  dayOfWeek            String // e.g. 'Monday', 'Tuesday'
  startTime            String // 'HH:mm' 24h
  endTime              String // 'HH:mm' 24h
  clinicName           String?
  clinicAddress        String?
  // Strategy v2: chamber location aids
  landmark             String?  // e.g. "Contai Bus Stand-এর পাশে"
  mapLink              String?  // Google Maps short link
  avgMinutesPerPatient Int      @default(10)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  appointments Appointment[]
  overrides   ScheduleOverride[]

  @@index([pinCode])
  @@index([doctorId])
  @@map("schedules")
}

// Phase 1 reform (Task 1.4) — schedule overrides.
// Allows compounders/doctors to mark a chamber closed or modify hours for a
// specific date without touching the regular weekly schedule.
model ScheduleOverride {
  id            String   @id @default(cuid())
  scheduleId    String
  schedule      Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date          String // 'YYYY-MM-DD'
  type          String // 'CLOSED' | 'MODIFIED_HOURS' | 'SPECIAL'
  newStartTime  String? // null when type = CLOSED
  newEndTime    String? // null when type = CLOSED
  reason        String? // 'অসুস্থ', 'পূজা', etc.
  createdBy     String  // AdminUser.id
  createdAt     DateTime @default(now())

  @@unique([scheduleId, date])
  @@index([scheduleId, date])
  @@map("schedule_overrides")
}

model Appointment {
  id              String   @id @default(cuid())
  scheduleId      String
  schedule        Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patientName     String
  patientPhone    String
  appointmentDate String // 'YYYY-MM-DD'
  queueNumber     Int
  status          String   @default("Confirmed") // Pending | Confirmed | Completed | Cancelled | NoShow
  // BUG-011 fix: explicit source field so the dashboard doesn't have to rely
  // on a sentinel phone number ('+0000000000') to tell walk-ins from online
  // bookings. Backward compatible — old rows default to 'ONLINE' which is
  // the correct value for every pre-existing row (the sentinel-phone walk-ins
  // are a small set that we'll patch at migration time).
  source          String   @default("ONLINE") // 'ONLINE' | 'WALK_IN'
  token           String   @unique @default(cuid())
  notes           String?
  reminderSent    Boolean  @default(false)
  feedbackSent    Boolean  @default(false) // Phase 1 reform (Task 2.1) — feedback request sent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  feedback        Feedback?

  // Race-condition protection: queue numbers must be unique per schedule+date
  @@unique([scheduleId, appointmentDate, queueNumber])
  @@index([scheduleId, appointmentDate])
  @@index([status])
  @@index([doctorId, appointmentDate])
  @@index([source])
  @@index([patientPhone])
  @@index([createdAt])
  @@map("appointments")
}

// Phase 1 reform (Task 2.1) — post-appointment patient feedback.
model Feedback {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating         Int      // 1-5 stars
  comment        String?
  createdAt      DateTime @default(now())

  @@index([rating])
  @@map("feedback")
}

// ── AdminUser (Doctor / Compounder / Super Admin) ───────────────────
// The same model holds all three role types. Doctor-specific fields
// (medicalRegNumber, verification, etc.) are nullable and only apply
// when role = DOCTOR.
model AdminUser {
  id       String  @id @default(cuid())

  // ── Role & verification ──────────────────────────────────────────
  role                Role                @default(COMPOUNDER)
  verificationStatus  VerificationStatus  @default(PENDING)

  // Doctor-specific (required if role = DOCTOR)
  medicalRegNumber    String?  @unique
  specialization      String?
  verificationDocs    Json?    // uploaded document URLs (for manual review)
  verifiedAt          DateTime?
  verifiedBy          String?  // AdminUser.id of the super admin who approved

  // Account ownership / delegation
  // If role = COMPOUNDER, this points to the Doctor profile they're scoped to.
  // If role = DOCTOR, their owned Doctor profile is reachable via `ownedDoctor`.
  delegatedDoctorId   String?
  delegatedDoctor     Doctor?  @relation("DoctorCompounders", fields: [delegatedDoctorId], references: [id], onDelete: SetNull)
  invitedBy           String?  // phone number of the doctor who invited this compounder
  invitedAt           DateTime?

  // ── Identity (bot-first) ────────────────────────────────────────
  // At least one of these must be set (enforced at app level).
  // `phone` is now the PRIMARY identifier for doctors (used for /register and /invite).
  // `whatsappNumber` is the primary bot identifier (WhatsApp Cloud API, E.164).
  // `telegramChatId` is kept for backward compatibility with legacy accounts.
  phone           String?  @unique
  email           String?  @unique
  telegramChatId  String?  @unique
  whatsappNumber  String?  @unique

  name         String
  // Password auth is disabled. Field kept for backward compatibility / future re-enable.
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── Relations ────────────────────────────────────────────────────
  ownedDoctor   Doctor?      @relation("DoctorOwner")
  failedLogins  FailedLogin[]
  auditLogs     AuditLog[]
  magicLinks    MagicLink[]
  sessions      Session[]
  patientNotes  PatientNote[] @relation("PatientNoteAuthor")

  @@index([role])
  @@index([verificationStatus])
  @@index([delegatedDoctorId])
  @@map("admin_users")
}

// Patient notes — internal notes that doctors/compounders can add to patients.
// Keyed by patient phone (the patient identifier) and scoped to the author
// so compounders see notes from their delegated doctor's team.
model PatientNote {
  id           String   @id @default(cuid())
  patientPhone String   // links to Appointment.patientPhone
  authorId     String   // AdminUser.id of the note author
  author       AdminUser @relation("PatientNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  note         String   // the note content
  isImportant  Boolean  @default(false) // pinned/flagged notes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientPhone])
  @@index([authorId])
  @@index([isImportant])
  @@map("patient_notes")
}

// Bot-driven Magic Link tokens — short-lived, single-use, hash-stored.
model MagicLink {
  id          String    @id @default(cuid())
  tokenHash   String    @unique // SHA-256 of the raw token
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime // Default: 2 hours from creation
  usedAt      DateTime? // Set when the link is consumed (single-use)
  ipAddress   String? // IP that consumed the link
  userAgent   String? // Browser UA at consumption time
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("magic_links")
}

model FailedLogin {
  id          Int        @id @default(autoincrement())
  email       String
  ipAddress   String?
  attemptedAt DateTime   @default(now())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([attemptedAt])
  @@map("failed_logins")
}

model AuditLog {
  id          Int        @id @default(autoincrement())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  target      String?
  detail      String?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([adminUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Persistent bot sessions (replaces in-memory Map)
model BotSession {
  chatId      String   @id
  step        String   @default("IDLE")
  sessionData String   @default("{}") // JSON string
  lang        String   @default("bn")
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("bot_sessions")
}

model Session {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("sessions")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  ip        String
  endpoint  String
  hits      Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([ip, endpoint])
  @@map("rate_limits")
}
